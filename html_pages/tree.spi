///- --package . --timeout 600000
:# tree static =
    :< testing

:< markup
:< doc_render
:< model
:< render
:< file_views
:< sm'_operators

:~ pad2 (n : i64) : string = ? n < 10i64 ?> "0" ++# show_i64 n |: show_i64 n

:~ hundredths (bytes : i64) (scale : i64) : string =
    := n = (bytes * 100i64 + scale / 2i64) / scale
    show_i64 (n / 100i64) ++# "." ++# pad2 (n % 100i64)

:~ bytes_label (bytes : i64) : string =
    ? bytes > 1048576i64
    ?> hundredths bytes 1048576i64 ++# " MB"
    |? bytes > 1024i64
    ?> hundredths bytes 1024i64 ++# " KB"
    |: hundredths bytes 1i64 ++# " B"

:~ ^ node_bytes (n : node) : i64 =
    ?= n ?|
    | File f => f::bytes
    | Folder f => nodes_bytes f::children
:& :~ nodes_bytes (ns : list node) : i64 =
    ?= ns ?|
    | n :: rest => node_bytes n + nodes_bytes rest
    | [] => 0i64

:~ char_order (a : string) (b : string) (i : i32) : i32 =
    ? sm'.char_code (sm::index a i) < sm'.char_code (sm::index b i) ?> -1i32 |: 1i32

:~ length_order (a : string) (b : string) (i : i32) : i32 =
    ? i = sm::length a && i = sm::length b
    ?> 0i32
    |? i = sm::length a
    ?> -1i32
    |: 1i32

:~ ^ compare_from (a : string) (b : string) (i : i32) : i32 =
    ? i = sm::length a || i = sm::length b
    ?> length_order a b i
    |? sm::index a i = sm::index b i
    ?> compare_from a b (i + 1i32)
    |: char_order a b i

:~ folder_rank (n : node) : i32 =
    ?= n ?|
    | Folder _ => 0i32
    | File _ => 1i32

:~ node_name (n : node) : string =
    ?= n ?|
    | Folder f => f::name
    | File f => f::name

:~ before (a : node) (b : node) : bool =
    ? folder_rank a = folder_rank b
    ?> compare_from (node_name a) (node_name b) 0i32 < 0i32
    |: folder_rank a < folder_rank b

:? listed_before t : t -> t -> bool

:+ listed_before node = \ a b => before a b

:~ ^ insert_by \* t {listed_before}. (x : t) (sorted : list t) : list t =
    ?= sorted ?|
    | m :: rest => ? listed_before x m ?> x :: sorted |: m :: insert_by x rest
    | [] => [ x ]

:~ ^ sort_by \* t {listed_before}. (xs : list t) : list t =
    ?= xs ?|
    | x :: rest => insert_by x (sort_by rest)
    | [] => []

:~ sort_nodes (ns : list node) : list node = sort_by ns

:~ join_rel (parent : string) (name : string) : string = ? parent = "" ?> name |: parent ++# "/" ++# name

:~ entry_link (icon : string) (href : string) (name : string) (bytes : i64) : markup =
    trusted (icon ++# " ") ++ anchor href (escape name) ++ trusted ("<span> (" ++# bytes_label bytes ++# ")</span>")

:~ raw_link (rel : string) : markup = trusted " " ++ anchor rel (trusted "<span>raw</span>")

:~ file_html (viewers : bool) (name : string) (rel : string) (bytes : i64) : markup =
    ? viewers && has_viewer name
    ?> entry_link "&#128196;" (rel ++# ".html") name bytes ++ raw_link rel
    |: entry_link "&#128196;" rel name bytes

:~ folder_html (rel : string) (name : string) (bytes : i64) (inner : markup) : markup =
    := summary = wrap "summary" (entry_link "&#128194;" rel name bytes)
    trusted "<details open=\"true\">" ++ summary ++ wrap "div" inner ++ trusted "</details>"

:~ node_by (r : list node -> markup) (viewers : bool) (n : node) : markup =
    ?= n ?|
    | File f => wrap "div" (file_html viewers f::name f::rel f::bytes)
    | Folder f => folder_html f::rel f::name (nodes_bytes f::children) (r f::children)

:~ ^ nodes_html (viewers : bool) (ns : list node) : markup =
    ?= ns ?|
    | n :: rest => node_by (nodes_html viewers) viewers n ++ nodes_html viewers rest
    | [] => trusted ""

:~ node_html (viewers : bool) (n : node) : markup = node_by (nodes_html viewers) viewers n

:+ to_html node = \ n => node_html !- n

:~ level_file (n : i64) (rel : string) : node =
    File { name = "file.txt"; rel = join_rel rel "file.txt"; bytes = n + 1i64 }

:~ level_folder (n : i64) (inner : string) (children : list node) : node =
    Folder { name = digit n; rel = inner; children = children }

:~ ^ level_fixture (n : i64) (rel : string) : list node =
    := inner = join_rel rel (digit n)
    ? n = 0i64 ?> [ level_file n rel ] |: [ level_folder n inner (level_fixture (n - 1i64) inner); level_file n rel ]

:= order_fixture () : list node =
    := file = \ (n : string) (b : i64) => File { name = n; rel = n; bytes = b }
    [ file "b.txt" 1i64; file "a.txt" 2i64; Folder { name = "m"; rel = "m"; children = [] }; file "B" 0i64 ]

:= linked_fixture () : string =
    "<div>&#128196; <a href=\"a.spi.html\">a.spi</a><span> (5.00 B)</span> <a href=\"a.spi\"><span>raw</span></a></div>"

:= plain_fixture () : string = "<div>&#128196; <a href=\"c.txt\">c.txt</a><span> (1.00 B)</span></div>"

:= nested_fixture () : list node =
    [ Folder { name = "_.root"; rel = "_.root"; children = level_fixture 3i64 "_.root" } ]

:= nested_a1 () : string =
    "<details open=\"true\"><summary>&#128194; <a href=\"_.root\">_.root</a><span> (10.00 B)</span></summary><div>"

:= nested_a2 () : string =
    "<details open=\"true\"><summary>&#128194; <a href=\"_.root/3\">3</a><span> (6.00 B)</span></summary><div>"

:= nested_a () : string =
    nested_a1 ()
    ++# nested_a2 ()
    ++# "<details open=\"true\"><summary>&#128194; <a href=\"_.root/3/2\">2</a><span> (3.00 B)</span></summary><div>"

:= nested_b1 () : string =
    "<details open=\"true\"><summary>&#128194; <a href=\"_.root/3/2/1\">1</a><span> (1.00 B)</span></summary><div>"

:= nested_b () : string =
    nested_b1 ()
    ++# "<div>&#128196; <a href=\"_.root/3/2/1/file.txt\">file.txt</a><span> (1.00 B)</span></div></div></details>"
    ++# "<div>&#128196; <a href=\"_.root/3/2/file.txt\">file.txt</a><span> (2.00 B)</span></div></div></details>"

:= nested_c () : string =
    "<div>&#128196; <a href=\"_.root/3/file.txt\">file.txt</a><span> (3.00 B)</span></div></div></details>"
    ++# "<div>&#128196; <a href=\"_.root/file.txt\">file.txt</a><span> (4.00 B)</span></div></div></details>"

///> rust
:# size_labels_switch_units_past_each_power =
    listm.map bytes_label [ 1024i64; 1025i64; 1048576i64; 1048577i64; 0i64 ]
    |> _assert_eq [ "1024.00 B"; "1.00 KB"; "1024.00 KB"; "1.00 MB"; "0.00 B" ]

///> rust
:# the_dir_tree_html_nested_fixture_renders_byte_for_byte =
    nodes_html !- (nested_fixture ()) |> markup_text |> _assert_eq (nested_a () ++# nested_b () ++# nested_c ())

///> rust
:# folders_come_first_then_names_in_ordinal_order =
    sort_nodes (order_fixture ()) |> listm.map node_name
    |> _assert_eq [ "m"; "B"; "a.txt"; "b.txt" ]

///> rust
:# folder_bytes_sum_their_children =
    nodes_bytes (nested_fixture ()) |> _assert_eq 10i64

:= linked_text (n : string) (b : i64) : string = node_html !+ (File { name = n; rel = n; bytes = b }) |> markup_text

///> rust
:# a_linked_file_gets_a_viewer_page_and_a_raw_link =
    (linked_text "a.spi" 5i64, linked_text "c.txt" 1i64)
    |> _assert_eq (linked_fixture (), plain_fixture ())
