///- --package . --timeout 600000
:# render static =
    :< testing

:< model
:< inline
:< markdown
:< sm'_operators

:~ ^ quoted (value : string) : markup = trusted "\"" ++ escape value ++ trusted "\""

:~ ^ wrap (tag : string) (body : markup) : markup = trusted ("<" ++# tag ++# ">") ++ body ++ trusted ("</" ++# tag ++# ">")

:~ ^ anchor (href : string) (body : markup) : markup = trusted "<a href=" ++ quoted href ++ trusted ">" ++ body ++ trusted "</a>"

:~ ^ image (alt : string) (src : string) : markup = trusted "<img src=" ++ quoted src ++ trusted " alt=" ++ quoted alt ++ trusted ">"

:~ ^ inline_html (x : inline) : markup =
    ?= x ?|
    | Text s => escape s
    | Code s => wrap "code" (escape s)
    | Strong xs => wrap "strong" (inlines_html xs)
    | Link (label, href) => anchor href (escape label)
    | Image (alt, src) => image alt src
    | AutoLink url => anchor url (escape url)
    | LinkedImage (alt, src, href) => anchor href (image alt src)
:& :~ inlines_html (xs : list inline) : markup =
    ?= xs ?|
    | x :: rest => inline_html x ++ inlines_html rest
    | [] => trusted ""

:~ ^ align_attr (a : align) : string =
    ?= a ?|
    | AlignNone => ""
    | AlignLeft => " style=\"text-align: left\""
    | AlignCenter => " style=\"text-align: center\""
    | AlignRight => " style=\"text-align: right\""

:~ ^ cell_html (tag : string) (a : align) (cell : list inline) : markup =
    trusted ("<" ++# tag ++# align_attr a ++# ">") ++ inlines_html cell ++ trusted ("</" ++# tag ++# ">")

:~ ^ cells_html (tag : string) (aligns : list align) (cells : list (list inline)) : markup =
    ?= cells ?|
    | [] => trusted ""
    | cell :: rest =>
        ?= aligns ?|
        | a :: more => cell_html tag a cell ++ cells_html tag more rest
        | [] => cell_html tag AlignNone cell ++ cells_html tag [] rest

:~ ^ row_html (tag : string) (aligns : list align) (cells : list (list inline)) : markup =
    trusted "<tr>" ++ cells_html tag aligns cells ++ trusted "</tr>\n"

:~ ^ rows_html (aligns : list align) (rows : list (list (list inline))) : markup =
    ?= rows ?|
    | row :: rest => row_html "td" aligns row ++ rows_html aligns rest
    | [] => trusted ""

:~ ^ items_html (items : list (list inline)) : markup =
    ?= items ?|
    | item :: rest => trusted "<li>" ++ inlines_html item ++ trusted "</li>\n" ++ items_html rest
    | [] => trusted ""

:~ ^ code_html (lines : list string) : markup =
    ?= lines ?|
    | s :: rest => escape s ++ trusted "\n" ++ code_html rest
    | [] => trusted ""

:~ ^ digit (n : i64) : string =
    ? n = 0i64 ?> "0" |? n = 1i64 ?> "1" |? n = 2i64 ?> "2" |? n = 3i64 ?> "3" |? n = 4i64 ?> "4"
    |? n = 5i64 ?> "5" |? n = 6i64 ?> "6" |? n = 7i64 ?> "7" |? n = 8i64 ?> "8" |: "9"

:~ ^ show_i64 (n : i64) : string = ? n < 10i64 ?> digit n |: show_i64 (n / 10i64) ++# digit (n % 10i64)

:~ ^ ordered_open (start : i64) : string = ? start = 1i64 ?> "<ol>\n" |: "<ol start=\"" ++# show_i64 start ++# "\">\n"

:~ ^ table_html (aligns : list align) (head : list (list inline)) (rows : list (list (list inline))) : markup =
    trusted "<table>\n<thead>\n" ++ row_html "th" aligns head ++ trusted "</thead>\n<tbody>\n" ++ rows_html aligns rows ++ trusted "</tbody>\n</table>\n"

:~ ^ block_html (b : block) : markup =
    ?= b ?|
    | Heading (l, xs) => wrap (level_tag l) (inlines_html xs) ++ trusted "\n"
    | Paragraph xs => trusted "<p>" ++ inlines_html xs ++ trusted "</p>\n"
    | Bullets items => trusted "<ul>\n" ++ items_html items ++ trusted "</ul>\n"
    | Numbered (start, items) => trusted (ordered_open start) ++ items_html items ++ trusted "</ol>\n"
    | CodeBlock lines => trusted "<pre><code>" ++ code_html lines ++ trusted "</code></pre>\n"
    | Rule => trusted "<hr>\n"
    | Table (aligns, head, rows) => table_html aligns head rows

:~ ^ blocks_html (bs : list block) : markup =
    ?= bs ?|
    | b :: rest => block_html b ++ blocks_html rest
    | [] => trusted ""

:? to_html t : t -> markup
:+ to_html inline = \ x => inline_html x
:+ to_html block = \ b => block_html b

:~ ^ markdown_html (s : string) : markup = blocks_html (parse_markdown s)

:~ ^ md (s : string) : string = markdown_html s |> markup_text

///> rust
:# every_inline_constructor_renders =
    inlines_html [Text "a&"; Code "<"; Strong [Text "b"]; Link ("l", "x.html"); AutoLink "https://x.org"] |> markup_text |> _assert_eq "a&amp;<code>&lt;</code><strong>b</strong><a href=\"x.html\">l</a><a href=\"https://x.org\">https://x.org</a>"

///> rust
:# images_and_badges_render =
    inlines_html [Image ("logo", "logo.png"); LinkedImage ("CI", "b.svg", "ci.html")] |> markup_text |> _assert_eq "<img src=\"logo.png\" alt=\"logo\"><a href=\"ci.html\"><img src=\"b.svg\" alt=\"CI\"></a>"

///> rust
:# the_prototype_dispatches_per_type =
    (to_html (Code "c") |> markup_text, to_html Rule |> markup_text) |> _assert_eq ("<code>c</code>", "<hr>\n")

///> rust
:# headings_and_paragraphs =
    md "# Title\n\nSome `code` and [a link](x.html)." |> _assert_eq "<h1>Title</h1>\n<p>Some <code>code</code> and <a href=\"x.html\">a link</a>.</p>\n"

///> rust
:# bullets_escape_and_close =
    md "- one\n- two <b>" |> _assert_eq "<ul>\n<li>one</li>\n<li>two &lt;b&gt;</li>\n</ul>\n"

///> rust
:# non_ascii_text_passes_through =
    md "봉쥬르 & é [깃허브](k.html)" |> _assert_eq "<p>봉쥬르 &amp; é <a href=\"k.html\">깃허브</a></p>\n"

///> rust
:# ordered_lists_with_and_without_a_start =
    (md "1. a", md "3. three\n   wrapped\n4. four") |> _assert_eq ("<ol>\n<li>a</li>\n</ol>\n", "<ol start=\"3\">\n<li>three wrapped</li>\n<li>four</li>\n</ol>\n")

///> rust
:# code_and_rule =
    md "```\nlet x = 1 < 2\n```\n\n---" |> _assert_eq "<pre><code>let x = 1 &lt; 2\n</code></pre>\n<hr>\n"

:= table_md () : string = "| A | B |\n| :- | -: |\n| `x` | y \\| z |"
:= table_head () : string = "<table>\n<thead>\n<tr><th style=\"text-align: left\">A</th><th style=\"text-align: right\">B</th></tr>\n</thead>\n"
:= table_body () : string = "<tbody>\n<tr><td style=\"text-align: left\"><code>x</code></td><td style=\"text-align: right\">y | z</td></tr>\n</tbody>\n</table>\n"

///> rust
:# a_gfm_table_renders_alignment_and_escaped_pipes =
    md (table_md ()) |> _assert_eq (table_head () ++# table_body ())

:= readme_md () : string =
    "# Title\n\nSome `code` and [a link](x.html).\n\n- one\n- two <b>\n\n봉쥬르 & é [깃허브](k.html)\n\n"
    ++# "Hi! ![logo](logo.png) [![CI](b.svg)](ci.html)\n\n**Bold** and <https://x.org> and \\*star\\*\n\n"
    ++# "---\n\n- top\n  - nested\n\n```\nlet x = 1 < 2\n```\n\n" ++# table_md () ++# "\n\n"
    ++# "3. three\n   wrapped\n4. four\n- lazy\nmore\n"

:= readme_a () : string =
    "<h1>Title</h1>\n<p>Some <code>code</code> and <a href=\"x.html\">a link</a>.</p>\n"
    ++# "<ul>\n<li>one</li>\n<li>two &lt;b&gt;</li>\n</ul>\n<p>봉쥬르 &amp; é <a href=\"k.html\">깃허브</a></p>\n"

:= readme_b () : string =
    "<p>Hi! <img src=\"logo.png\" alt=\"logo\"> <a href=\"ci.html\"><img src=\"b.svg\" alt=\"CI\"></a></p>\n"
    ++# "<p><strong>Bold</strong> and <a href=\"https://x.org\">https://x.org</a> and *star*</p>\n<hr>\n<ul>\n"

:= readme_c () : string =
    "<li>top</li>\n<li>nested</li>\n</ul>\n<pre><code>let x = 1 &lt; 2\n</code></pre>\n" ++# table_head () ++# table_body ()
    ++# "<ol start=\"3\">\n<li>three wrapped</li>\n<li>four</li>\n</ol>\n<ul>\n<li>lazy more</li>\n</ul>\n"

///> rust
:# the_dir_tree_html_readme_fixture_renders_byte_for_byte =
    md (readme_md ()) |> _assert_eq (readme_a () ++# readme_b () ++# readme_c ())
