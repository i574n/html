///- --package . --timeout 600000
:# viewer static =
    :< testing

:< model
:< markdown
:< render
:< sm'_operators

:~ ^ last_dot (name : string) (i : i32) (found : i32) : i32 =
    ? i >= sm::length name ?> found
    |? sm::index name i = '.' ?> last_dot name (i + 1i32) i
    |: last_dot name (i + 1i32) found

:~ ^ extension (name : string) : string =
    := dot = last_dot name 0i32 -1i32
    ? dot <= 0i32 ?> "" |: run_of name (dot + 1i32) (sm::length name)

:= source_extensions () : list string =
    listm.append ["spi"; "spir"; "spiproj"; "toml"; "ps1"; "psm1"; "fs"; "fsx"; "fsproj"; "rs"; "gleam"; "ex"; "exs"; "zig"; "c"] ["h"; "cpp"; "cs"; "py"; "sh"; "cmd"; "bat"; "lock"; "cfg"; "ini"; "sql"; "csv"; "dib"; "livemd"]

:~ ^ listed (ext : string) (exts : list string) : bool =
    ?= exts ?|
    | e :: rest => e = ext || listed ext rest
    | [] => !-

:~ ^ viewer_of (name : string) : viewer =
    := ext = extension name
    ? ext = "tsv" ?> Delimited
    |? ext = "md" ?> Prose
    |? listed ext (source_extensions ()) ?> Source
    |: Direct

:~ ^ has_viewer (name : string) : bool =
    ?= viewer_of name ?|
    | Direct => !-
    | _ => !+

:~ ^ tab_cells (tag : string) (s : string) (i : i32) (start : i32) : markup =
    ? i >= sm::length s ?> wrap tag (escape (run_of s start i))
    |? sm::index s i = '\t' ?> wrap tag (escape (run_of s start i)) ++ tab_cells tag s (i + 1i32) (i + 1i32)
    |: tab_cells tag s (i + 1i32) start

:~ ^ tab_rows (lines : list string) (tag : string) : markup =
    ?= lines ?|
    | s :: rest => ? s = "" ?> tab_rows rest tag |: trusted "<tr>" ++ tab_cells tag s 0i32 0i32 ++ trusted "</tr>\n" ++ tab_rows rest "td"
    | [] => trusted ""

:~ ^ viewer_body (kind : viewer) (text : string) : markup =
    ?= kind ?|
    | Direct => trusted ""
    | Source => trusted "<pre><code>" ++ escape text ++ trusted "</code></pre>\n"
    | Delimited => trusted "<table>\n" ++ tab_rows (lines_from text 0i32 0i32 []) "th" ++ trusted "</table>\n"
    | Prose => trusted "<section class=\"readme\">\n" ++ markdown_html text ++ trusted "</section>\n"

///> rust
:# extensions_pick_the_viewer =
    listm.map viewer_of ["a.spi"; "b.tsv"; "c.md"; "d.txt"; ".spi"; "Cargo.lock"] |> _assert_eq [Source; Delimited; Prose; Direct; Direct; Source]

///> rust
:# a_source_file_is_escaped_into_pre_code =
    viewer_body Source "x < 1" |> markup_text |> _assert_eq "<pre><code>x &lt; 1</code></pre>\n"

///> rust
:# a_tsv_file_becomes_a_table_with_a_header_row =
    viewer_body Delimited "h1\th2\n\nv1\tv2" |> markup_text |> _assert_eq "<table>\n<tr><th>h1</th><th>h2</th></tr>\n<tr><td>v1</td><td>v2</td></tr>\n</table>\n"

///> rust
:# a_markdown_file_renders_as_a_readme_section =
    viewer_body Prose "# T" |> markup_text |> _assert_eq "<section class=\"readme\">\n<h1>T</h1>\n</section>\n"
