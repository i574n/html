///- --package . --timeout 600000
:# model static =
    :< testing

:< sm'_operators
:< markup
:< doc_blocks

:| viewer =
    | Direct
    | Source
    | Delimited
    | Prose
    | Picture
    | Diagram

:| ^ node =
    | File : { name : string; rel : string; bytes : i64 }
    | Folder : { name : string; rel : string; children : list node }

:! index_page = ()
:! file_page = ()

:| ^ page kind =
    | IndexPage :: markup -> page index_page
    | FilePage :: markup -> page file_page

:~ at_is (s : string) (i : i32) (c : char) : bool = i < sm::length s && sm::index s i = c

:~ ^ spaces_from (s : string) (i : i32) : i32 =
    ? i < sm::length s && sm::index s i = ' ' ?> spaces_from s (i + 1i32) |: i

:~ ^ trail_from (s : string) (i : i32) : i32 =
    ? i > 0i32 && sm::index s (i - 1i32) = ' ' ?> trail_from s (i - 1i32) |: i

:~ trim (s : string) : string = run_of s (spaces_from s 0i32) (trail_from s (sm::length s))

:= page_text \* k. (p : page k) : string =
    ?= p ?|
    | IndexPage m => markup_text m
    | FilePage m => markup_text m

///> rust
///> gleam
:# trim_drops_surrounding_spaces_only =
    (trim "  a b  ", trim "", trim "x") |> _assert_eq ("a b", "", "x")

///> rust
///> gleam
:# a_page_keeps_its_kind_static =
    (page_text (IndexPage (trusted "i")), page_text (FilePage (trusted "f"))) |> _assert_eq ("i", "f")
